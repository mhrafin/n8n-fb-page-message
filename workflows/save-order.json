    {
      "parameters": {
        "jsCode": "const input = $('Executed by messenger-automation').first().json\nconst p = $input.first().json\n\nif (!p.price_bdt) return [{ json: { ok: false, error: 'Product not found. Use the exact product_id from the products sheet.' } }]\n\nconst qty = Number(input.quantity)\nif (!Number.isInteger(qty) || qty < 1)\n  return [{ json: { ok: false, error: 'Invalid quantity' } }]\n\nif (Number(p.stock) < qty)\n  return [{ json: { ok: false, error: 'Only ' + p.stock + ' in stock' } }]\n\nconst price = Number(String(p.price_bdt).replace(/[^\\d.]/g, ''))\nconst quoted = Number(String(input.quoted_total).replace(/[^\\d.]/g, ''))\nconst total = price * qty\n\nif (quoted !== total)\n  return [{ json: { ok: false, error: 'Total mismatch. Correct total is ' + total } }]\n\nreturn [{ json: {\n  ok: true,\n  order_id: 'ORD-' + String(input.mid).slice(-12),\n  customer_id: input.sender_id,\n  customer_name: input.customer_name,\n  mobile: input.mobile,\n  address: input.address,\n  product_id: input.product_id,\n  quantity: qty,\n  total,\n  bkash_number: input.bkash_number,\n  transaction_id: input.transaction_id,\n  status: 'Pending verification',\n  order_date: new Date().toISOString()\n} }]"
      },
